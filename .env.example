# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
# job_agent.py loads `.env` at startup and never overwrites variables that are
# already set in your shell environment.


# ---------------------------------------------------------------------------
# REQUIRED for the AI features (query parsing + ranking)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# Without it the tool still runs: it falls back to local keyword scoring and
# prints a warning. Use `--no-rank` to skip the Claude calls deliberately.
ANTHROPIC_API_KEY=sk-ant-...

# Alternative to the key above: run `ant auth login` once and the SDK picks up
# the stored profile automatically - then leave ANTHROPIC_API_KEY unset.


# ---------------------------------------------------------------------------
# OPTIONAL SOURCE 1: Adzuna  (enable with --use-adzuna)
# ---------------------------------------------------------------------------
# Free developer account: https://developer.adzuna.com/
#   1. Sign up and confirm your email.
#   2. The dashboard shows an "Application ID" and an "Application Key".
#   3. Paste them below, then run:  python job_agent.py "..." --use-adzuna
# Adzuna is country-scoped; pick the country with --adzuna-country
# (gb, us, de, in, au, ca, fr, nl, ...). Default is gb.
# Free tier: roughly 250 calls/day, 25 results per call.
#ADZUNA_APP_ID=
#ADZUNA_APP_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL SOURCE 2: USAJobs  (enable with --use-usajobs)
# ---------------------------------------------------------------------------
# US FEDERAL GOVERNMENT JOBS ONLY - not useful outside the United States.
# Free API key: https://developer.usajobs.gov/APIRequest/Index
#   1. Request a key with your email address; it arrives by email.
#   2. USAJobs requires that same registered email as the User-Agent header,
#      so BOTH variables below are mandatory.
#   3. Then run:  python job_agent.py "..." --use-usajobs
#USAJOBS_API_KEY=
#USAJOBS_EMAIL=you@example.com
